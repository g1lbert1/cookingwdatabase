# Copy to .env and fill in. .env is gitignored; .env.example is committed.
MONGO_URL=mongodb://localhost:27017/
MONGO_DB=cookingwdatabase

AUTH0_DOMAIN=dev-5jcvwvffofu7udns.us.auth0.com
AUTH0_AUDIENCE=https://cookingwtristan-api.com

# Seeded as role "admin" on first login. Must match the email claim in the token.
ADMIN_EMAIL=robotic140@gmail.com

PORT=4000
HOST=0.0.0.0

# Browser origins allowed to call /graphql, comma-separated. Default is the
# Vite dev server. Set to your deployed frontend URL in production.
CORS_ORIGIN=http://localhost:5173

# Set to "production" when deployed: disables schema introspection and strips
# stack traces from error responses.
# NODE_ENV=production

# Requests per IP per 15 minutes. Default 300.
# RATE_LIMIT_MAX=300
